diff --git a/include/image.mk b/include/image.mk
--- a/include/image.mk
+++ b/include/image.mk
@@ -211,2 +211,4 @@
 define Image/pad-to
-	dd if=$(1) of=$(1).new bs=$(2) conv=sync
+	rm -f $(1).new
+	truncate -s $(2) $(1).new
+	dd if=$(1) of=$(1).new bs=4M conv=notrunc,sparse
diff --git a/scripts/gen_image_generic.sh b/scripts/gen_image_generic.sh
--- a/scripts/gen_image_generic.sh
+++ b/scripts/gen_image_generic.sh
@@ -29,1 +29,2 @@
 ROOTFSSIZE="$(($4 / 512))"
+truncate -s "$(((ROOTFSOFFSET + ROOTFSSIZE) * 512))" "$OUTPUT"
@@ -49,2 +50,1 @@
-[ -n "$PADDING" ] && dd if=/dev/zero of="$OUTPUT" bs=512 seek="$ROOTFSOFFSET" conv=notrunc count="$ROOTFSSIZE"
-dd if="$ROOTFSIMAGE" of="$OUTPUT" bs=512 seek="$ROOTFSOFFSET" conv=notrunc
+dd if="$ROOTFSIMAGE" of="$OUTPUT" bs=4M seek="$((ROOTFSOFFSET / 8192))" conv=notrunc,sparse
